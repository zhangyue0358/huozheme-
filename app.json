{
  "expo": {
    "name": "在否",
    "slug": "huozhema-app",
    "description": "一个轻量的每日确认与好友状态 App：确认今天还在，记下心情、随笔、照片和今天最想做的三件事。",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#151515"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "允许“在否”选择头像或随笔照片。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "允许“在否”使用 Face ID 安全登录。"
        }
      ],
      "expo-notifications"
    ],
    "ios": {
      "bundleIdentifier": "com.huozhema.app",
      "buildNumber": "18",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "允许“在否”使用 Face ID 安全登录。",
        "NSPhotoLibraryUsageDescription": "允许“在否”选择头像或随笔照片。"
      },
      "requireFullScreen": false,
      "supportsTablet": true
    },
    "android": {
      "package": "com.huozhema.app",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#151515"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bfb2f36f-61ff-40f0-b4c8-756ff862b654"
      }
    },
    "owner": "zhangyue0358"
  }
}
