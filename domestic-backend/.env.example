PORT=8080
NODE_ENV=development

# PostgreSQL on Aliyun RDS or a self-hosted PostgreSQL service.
DATABASE_URL=
DB_SSL=false

# Generate long random strings before production.
JWT_SECRET=change_me_to_a_long_random_secret
OTP_SECRET=change_me_to_another_long_random_secret

# console is for local testing. aliyun sends real SMS.
SMS_PROVIDER=console
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=北京森贝科技
ALIYUN_SMS_TEMPLATE_CODE=SMS_336275110

# Later used when issuing OSS upload policies.
ALIYUN_OSS_REGION=oss-cn-beijing
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
